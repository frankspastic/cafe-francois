# Server Configuration
PORT=3000

# Where the SQLite file lives. Defaults to server/db/cafe-francois.db.
# On Railway, point this at a mounted volume (e.g. /data/cafe-francois.db) or
# the database is wiped on every deploy.
# DB_PATH=/data/cafe-francois.db

# Comma-separated origins allowed to call the API cross-origin.
# Defaults to http://localhost:5173 for the Vite dev server. In production the
# client is served from the same origin, so this usually needs nothing.
# ALLOWED_ORIGINS=https://cafe.maulit.net

# Set to true for verbose order/database logging.
# DEBUG=false

# Barista PIN (4 digits)
# Only used to seed the initial PIN on first run — after that, the PIN is
# stored (hashed) in the database and changed from Barista dashboard > Appearance.
BARISTA_PIN=1234

# Forgot the barista PIN? Set this to a new 4-digit PIN and restart the server —
# it overwrites the stored PIN on startup. Remove the variable again afterward.
# RESET_BARISTA_PIN=1234

# Label Printer (Bluetooth thermal printer via CUPS)
# Run: lpstat -p    to find your exact printer name
LABEL_PRINTER_NAME=_PM_241_BT
