# Server Configuration
PORT=3000

# Barista PIN (4 digits)
# Only used to seed the initial PIN on first run — after that, the PIN is
# stored (hashed) in the database and changed from Barista dashboard > Appearance.
BARISTA_PIN=1234

# Forgot the barista PIN? Set this to a new 4-digit PIN and restart the server —
# it overwrites the stored PIN on startup. Remove the variable again afterward.
# RESET_BARISTA_PIN=1234

# Label Printer (Bluetooth thermal printer via CUPS)
# Run: lpstat -p    to find your exact printer name
LABEL_PRINTER_NAME=_PM_241_BT
